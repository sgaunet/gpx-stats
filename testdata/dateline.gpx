<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="gpx-stats-test" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Antimeridian Crossing</name>
    <!-- Runs eastward across 180 degrees longitude. Raw longitudes jump from
         +179.95 to -179.95; unwrapped they continue 179.9 -> 180.1, so the
         drawn line must span ~0.2 degrees, not ~359.8. -->
    <trkseg>
      <trkpt lat="-16.5000" lon="179.9000"><ele>10.0</ele><time>2023-06-15T08:00:00Z</time></trkpt>
      <trkpt lat="-16.5010" lon="179.9500"><ele>12.0</ele><time>2023-06-15T08:00:30Z</time></trkpt>
      <trkpt lat="-16.5020" lon="-179.9500"><ele>14.0</ele><time>2023-06-15T08:01:00Z</time></trkpt>
      <trkpt lat="-16.5030" lon="-179.9000"><ele>16.0</ele><time>2023-06-15T08:01:30Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
